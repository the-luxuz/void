prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${pcfiledir}/../../lib
includedir=${pcfiledir}/../../include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 11.14.103
Requires: 
Requires.private: libswscale >= 9.5.103, libswresample >= 6.3.103, libavutil >= 60.26.103
Conflicts:
Libs: -L${libdir}  -lavfilter 
Libs.private: -lm -latomic -lz
Cflags: -I${includedir}
