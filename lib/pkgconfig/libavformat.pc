prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${pcfiledir}/../../lib
includedir=${pcfiledir}/../../include

Name: libavformat
Description: FFmpeg container format library
Version: 62.12.103
Requires: 
Requires.private: libavcodec >= 62.28.103, libswresample >= 6.3.103, libavutil >= 60.26.103
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm -latomic -lz
Cflags: -I${includedir}
