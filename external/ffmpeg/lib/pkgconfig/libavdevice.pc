prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${pcfiledir}/../../lib
includedir=${pcfiledir}/../../include

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.3.103
Requires: 
Requires.private: libavformat >= 62.12.103, libavcodec >= 62.28.103, libswresample >= 6.3.103, libavutil >= 60.26.103
Conflicts:
Libs: -L${libdir}  -lavdevice 
Libs.private: -lm -latomic
Cflags: -I${includedir}
